[Unit]
Description=YouthLink verified web data pipeline
Documentation=file://@REPO_DIR@/docs/aws-ec2-operations.md
Wants=network-online.target
After=network-online.target youthlink-policy-pipeline.service
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@REPO_DIR@/.env
ExecStart=@PYTHON_PATH@ etl/run_web_pipeline.py --resume-latest-failed
ExecStart=@PYTHON_PATH@ etl/check_pipeline_health.py --json
Restart=on-failure
RestartSec=15min
TimeoutStartSec=6h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=youthlink-web-pipeline
