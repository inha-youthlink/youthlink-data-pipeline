[Unit]
Description=YouthLink policy API pipeline
Documentation=file://@REPO_DIR@/docs/aws-ec2-operations.md
Wants=network-online.target
After=network-online.target
OnSuccess=youthlink-web-pipeline.service
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@REPO_DIR@/.env
ExecStart=@PYTHON_PATH@ etl/run_policy_pipeline.py --resume-latest-failed
Restart=on-failure
RestartSec=15min
TimeoutStartSec=6h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=youthlink-policy-pipeline
